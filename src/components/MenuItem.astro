---
import type { MenuItem } from '../lib/types';
import Tile from './Tile.astro';

export interface Props {
  item: MenuItem;
  illo: string;
  /** великий рядок для колонок «Улюблене» */
  featured?: boolean;
}

const { item, illo, featured = false } = Astro.props;
const formatted = new Intl.NumberFormat('uk-UA').format(item.price);
const tagLabel = item.tag === 'hit' ? 'хіт' : item.tag === 'new' ? 'новинка' : null;
---

<article class:list={['menu-item', { 'menu-item--featured': featured }]}>
  <Tile src={illo} size={featured ? 200 : 100} bg={featured ? 'cream' : 'cream'} />

  <div class="menu-item__body">
    <div class="menu-item__head">
      <h3 class="menu-item__name">{item.name}</h3>
      {tagLabel && <span class:list={['tag', `tag--${item.tag}`]}>{tagLabel}</span>}
      <span class="menu-item__leader" aria-hidden="true"></span>
      <p class="menu-item__price">
        <span class="sr-only">{item.name}: </span>{formatted} грн
      </p>
    </div>
    <p class="menu-item__desc">{item.description}</p>
  </div>
</article>

<style>
  .menu-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-5);
    align-items: center;
  }
  .menu-item__body {
    min-width: 0;
  }
  .menu-item__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .menu-item__name {
    font-family: var(--font-h3);
    font-weight: 700;
    font-size: var(--fs-item);
    line-height: var(--lh-item);
    margin: 0;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-white);
    background: var(--c-coral-deep);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .tag--new {
    background: var(--c-teal);
  }
  /* Лідер-крапки між назвою й ціною, як у друкованому меню */
  .menu-item__leader {
    flex: 1 1 24px;
    min-width: 24px;
    border-bottom: var(--leader);
    margin-top: 0.55em;
    order: 2;
  }
  .menu-item__price {
    order: 3;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-price);
    line-height: var(--lh-price);
    color: var(--c-coral-deep);
    white-space: nowrap;
  }
  .menu-item__head .tag {
    order: 1;
  }
  .menu-item__desc {
    margin-top: var(--sp-1);
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    max-width: 52ch;
  }

  .menu-item--featured {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    gap: var(--sp-4);
    align-content: start;
  }
  .menu-item--featured :global(.tile) {
    width: 100%;
    max-width: 220px;
    margin-inline: auto;
  }
  .menu-item--featured :global(.tile img) {
    width: 78%;
  }
  .menu-item--featured .menu-item__leader {
    flex: 1 1 8px;
    min-width: 8px;
  }
  .menu-item--featured .menu-item__head {
    flex-wrap: nowrap;
    gap: var(--sp-2);
  }
  .menu-item--featured .menu-item__name {
    flex-shrink: 1;
    min-width: 0;
  }

  @media (max-width: 40rem) {
    .menu-item {
      grid-template-columns: auto 1fr;
      gap: var(--sp-4);
    }
    /* дозволяємо ціні переноситись, якщо назва довга (360px) */
    .menu-item:not(.menu-item--featured) .menu-item__head {
      flex-wrap: wrap;
      row-gap: 2px;
    }
    .menu-item__leader {
      display: none;
    }
    .menu-item:not(.menu-item--featured) .menu-item__price {
      flex-basis: 100%;
      text-align: left;
    }
    .menu-item:not(.menu-item--featured) .menu-item__head .tag {
      order: 0;
      flex-basis: 100%;
    }

    /* «Улюблене» на телефоні: назва й ціна в одному рядку, тег — під ними.
       Без цього правила назва ламалась по складах («Фл / ет / вайт»). */
    .menu-item--featured .menu-item__head {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name price'
        'tag tag';
      align-items: baseline;
      column-gap: var(--sp-2);
      row-gap: var(--sp-1);
    }
    .menu-item--featured .menu-item__name {
      grid-area: name;
      min-width: 0;
      overflow-wrap: normal;
      hyphens: manual;
    }
    .menu-item--featured .menu-item__price {
      grid-area: price;
      text-align: right;
    }
    .menu-item--featured .tag {
      grid-area: tag;
      justify-self: start;
    }
    .menu-item--featured .menu-item__leader {
      display: none;
    }
  }
</style>
