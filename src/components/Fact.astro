---
import type { SiteData } from '../lib/types';

export interface Props {
  site: SiteData;
  kind?: 'pin' | 'phone' | 'clock' | 'wifi' | 'bag' | 'card' | 'calendar';
}

const { site, kind = 'pin' } = Astro.props;

const text: Record<string, { icon: string; label: string; href?: string }> = {
  pin: { icon: 'M 12 21.4 C 12 21.4 4.6 14.1 4.6 9.6 C 4.6 5.513 7.913 2.2 12 2.2 C 16.087 2.2 19.4 5.513 19.4 9.6 C 19.4 14.1 12 21.4 12 21.4 Z M 14.5 9.6 C 14.5 10.981 13.381 12.1 12 12.1 C 10.619 12.1 9.5 10.981 9.5 9.6 C 9.5 8.219 10.619 7.1 12 7.1 C 13.381 7.1 14.5 8.219 14.5 9.6 Z', label: `${site.address.street}, ${site.address.city}` },
  phone: { icon: 'M 6.6 3.6 L 9.4 3.6 L 11 8 L 8.8 9.6 C 9.8 13.2 10.8 14.2 14.4 15.2 L 16 11 L 20.4 12.6 L 20.4 15.6 C 20.4 17.26 19.06 18.6 17.4 18.6 C 9.3 18.6 3.4 12.7 3.4 6.6 C 3.4 4.94 4.74 3.6 6.4 3.6 Z', label: site.phoneDisplay, href: `tel:${site.phone}` },
  clock: { icon: 'M 12 3 C 16.971 3 21 7.029 21 12 C 21 16.971 16.971 21 12 21 C 7.029 21 3 16.971 3 12 C 3 7.029 7.029 3 12 3 Z M 12 7 L 12 12.4 L 15.8 14.6', label: 'Години роботи' },
  wifi: { icon: 'M 3.8 8.8 C 5.85 7.811 8.817 6.2 12 6.2 C 15.183 6.2 18.15 7.811 19.884 10.48 M 7 12.4 C 8.467 11.125 10.171 10.2 12 10.2 C 13.829 10.2 15.533 11.125 16.529 12.659 M 10 15.8 C 10.299 13.446 11.12 13 12 13 C 12.88 13 13.701 13.446 14.181 14.184 M 12 18.6 L 12 19.3', label: 'Wi-Fi та розетки' },
  bag: { icon: 'M 5.6 7.6 L 18.4 7.6 L 19.6 20.4 L 4.4 20.4 Z M 8.6 7.6 L 8.6 5.6 C 8.6 3.722 10.122 2.2 12 2.2 C 13.878 2.2 15.4 3.722 15.4 5.6 L 15.4 7.6', label: 'Кава з собою' },
  card: { icon: 'M 2.9 5.4 L 21.1 5.4 L 21.1 18.6 L 2.9 18.6 Z M 2.9 5.9 L 12 13 L 21.1 5.9', label: site.email, href: `mailto:${site.email}` },
  calendar: { icon: 'M 3.6 6.2 L 20.4 6.2 L 20.4 20.4 L 3.6 20.4 Z M 3.6 10.6 L 20.4 10.6 M 8 3.6 L 8 7.8 M 16 3.6 L 16 7.8', label: 'Пн–Нд · відчинено', href: '#hours' },
};
const t = text[kind]!;
---

{
  t.href ? (
    <a class="fact" href={t.href}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path
          d={t.icon}
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span>{t.label}</span>
    </a>
  ) : (
    <span class="fact">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path
          d={t.icon}
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span>{t.label}</span>
    </span>
  )
}

<style>
  .fact {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--c-ink);
    text-decoration: none;
    min-height: 32px;
  }
  .fact svg {
    color: var(--c-coral-deep);
    flex-shrink: 0;
  }
  a.fact:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 2px;
  }
</style>
