---
export interface Props {
  href?: string;
  variant?: 'primary' | 'light' | 'ghost' | 'dark';
  type?: 'button' | 'submit';
  full?: boolean;
  name?: string;
  value?: string;
  id?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  full = false,
  name,
  value,
  id,
  ariaLabel,
  disabled = false,
} = Astro.props;

const cls = ['btn', `btn--${variant}`, full ? 'btn--full' : ''].filter(Boolean).join(' ');
---

{
  href ? (
    <a class={cls} href={href} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button
      class={cls}
      type={type}
      name={name}
      value={value}
      id={id}
      aria-label={ariaLabel}
      disabled={disabled}
    >
      <slot />
    </button>
  )
}

<style is:global>
  .btn {
    /* ціль дотику ≥ 44px */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 52px;
    padding: var(--sp-3) var(--sp-6);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    border: var(--border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition:
      box-shadow 0.12s ease,
      transform 0.12s ease,
      background-color 0.12s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .btn:focus-visible {
    outline: 3px solid var(--c-teal-deep);
    outline-offset: 3px;
  }
  .btn--primary {
    background: var(--c-coral-deep);
    color: var(--c-white);
    box-shadow: var(--shadow-button);
  }
  .btn--primary:hover {
    background: #9c331d;
    box-shadow: var(--shadow-button-hover);
    transform: translate(2px, 2px);
  }
  .btn--primary:active {
    box-shadow: none;
    transform: translate(3px, 3px);
  }
  .btn--light {
    background: var(--c-paper);
    color: var(--c-ink);
    box-shadow: var(--shadow-button);
  }
  .btn--light:hover {
    box-shadow: var(--shadow-button-hover);
    transform: translate(2px, 2px);
  }
  .btn--ghost {
    background: transparent;
    color: var(--c-ink);
  }
  .btn--ghost:hover {
    background: var(--c-cream);
  }
  .btn--dark {
    background: var(--c-ink);
    color: var(--c-cream);
  }
  .btn--dark:hover {
    background: #3a2d2c;
  }
  .btn--full {
    width: 100%;
  }
  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn--primary:hover,
    .btn--light:hover {
      transition: none;
      transform: none;
    }
  }
</style>
