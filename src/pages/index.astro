---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Fact from '../components/Fact.astro';
import HoursTable from '../components/HoursTable.astro';
import OpenNow from '../components/OpenNow.astro';
import MenuItem from '../components/MenuItem.astro';
import Tile from '../components/Tile.astro';
import Illo from '../components/Illo.astro';
import { loadData } from '../../scripts/load-data.mjs';
import type { MenuCategory, IlloKey, SiteData } from '../lib/types';

const illoUrl = (key: string): string => '/illo/' + key + '.svg';

const loaded = loadData(process.cwd());
const site = loaded.site as SiteData;
const menu = loaded.menu as MenuCategory[];
const fmt = new Intl.NumberFormat('uk-UA');

// «Улюблене»: по одному хіту з трьох категорій
const picks = [
  menu.find((c) => c.category === 'kava')!.items.find((i) => i.tag === 'hit')!,
  menu.find((c) => c.category === 'chai')!.items.find((i) => i.tag === 'hit')!,
  menu.find((c) => c.category === 'deserty')!.items.find((i) => i.tag === 'hit')!,
];

const hoursJson = JSON.stringify({
  hours: site.hours,
  closures: site.closures,
  timezone: site.timezone,
});
---

<Base
  title="Кава, десерти і тихе місце для роботи"
  description="BrewMug — кав'ярня на Подолі. Меню, адреса, години роботи й бронювання столика. Кава власної обсмажки, свіжа випічка, Wi-Fi та розетки біля кожного столика."
  current="home"
>
  <script id="hours-data" type="application/json" is:inline set:html={hoursJson} />

  {/* HERO — адреса, години й телефон на першому екрані (BR 001, ФВ-4) */}
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hand hero__kicker">{site.tagline.includes('Кава') ? 'кавʼярня на Подолі' : 'кавʼярня'}</p>
        <h1 class="hero__title">Кава, десерти<br />і тихе місце<br />для роботи</h1>
        <p class="hero__lead">
          Обсмажуємо зерно щотижня, печемо десерти щоранку. Wi-Fi, розетки біля кожного столика й меню, яке
          читається з телефона.
        </p>

        <div class="hero__actions">
          <Button href="/broniuvannia/">Забронювати столик</Button>
          <Button href="/menu/kava/" variant="light">Подивитись меню</Button>
        </div>

        <div class="hero__facts">
          <Fact {site} kind="pin" />
          <Fact {site} kind="phone" />
          <OpenNow fallback="Години роботи — нижче" />
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <div class="hero__sun"></div>
        <div class="hero__ring"></div>
        <img
          class="hero__cup"
          src={illoUrl('flat')}
          width="405"
          height="405"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
        <span class="hero__stamp">свіжа<br />обсмажка</span>
      </div>
    </div>
  </section>

  {/* Смуга: відчинено + адреса + телефон */}
  <section class="visit-band" aria-label="Швидка інформація">
    <div class="container visit-band__inner">
      <span class="visit-item">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
          ><path
            d="M 12 3 C 16.971 3 21 7.029 21 12 C 21 16.971 16.971 21 12 21 C 7.029 21 3 16.971 3 12 C 3 7.029 7.029 3 12 3 Z M 12 7 L 12 12.4 L 15.8 14.6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
        <span><OpenNow fallback="Дивіться години роботи" /></span>
      </span>
      <span class="visit-item">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
          ><path
            d="M 12 21.4 C 12 21.4 4.6 14.1 4.6 9.6 C 4.6 5.513 7.913 2.2 12 2.2 C 16.087 2.2 19.4 5.513 19.4 9.6 C 19.4 14.1 12 21.4 12 21.4 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
        {site.address.street}, {site.address.city}
      </span>
      <a class="visit-item visit-item--link" href={`tel:${site.phone}`}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
          ><path
            d="M 6.6 3.6 L 9.4 3.6 L 11 8 L 8.8 9.6 C 9.8 13.2 10.8 14.2 14.4 15.2 L 16 11 L 20.4 12.6 L 20.4 15.6 C 20.4 17.26 19.06 18.6 17.4 18.6 C 9.3 18.6 3.4 12.7 3.4 6.6 C 3.4 4.94 4.74 3.6 6.4 3.6 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
        {site.phoneDisplay}
      </a>
    </div>
  </section>

  {/* Улюблене */}
  <section class="section favorites" aria-labelledby="fav-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="hand">що беруть найчастіше</p>
          <h2 id="fav-title">Улюблене наших гостей</h2>
        </div>
        <a class="arrow-link" href="/menu/kava/">Усе меню <span aria-hidden="true">→</span></a>
      </div>
      <div class="favorites__grid">
        {
          picks.map((it) => (
            <MenuItem item={it} illo={illoUrl(it.illo)} featured />
          ))
        }
      </div>
    </div>
  </section>

  {/* Чому ми */}
  <section class="section why" aria-labelledby="why-title">
    <div class="container">
      <p class="hand">чому до нас повертаються</p>
      <h2 id="why-title">Менше зайвого — більше кави</h2>
      <ol class="why__list" role="list">
        <li class="why__item">
          <span class="why__num" aria-hidden="true">1</span>
          <div>
            <h3>Зерно з обсмажки</h3>
            <p>Обсмажуємо малими партіями щочетверга. На пачці — дата, а не «термін придатності».</p>
          </div>
        </li>
        <li class="why__item">
          <span class="why__num" aria-hidden="true">2</span>
          <div>
            <h3>Місце для роботи</h3>
            <p>Тихий зал, довгі столи з розетками, швидкий Wi-Fi. Сидіть скільки треба.</p>
          </div>
        </li>
        <li class="why__item">
          <span class="why__num" aria-hidden="true">3</span>
          <div>
            <h3>Меню без PDF</h3>
            <p>Ціни й складники читаються з телефона. Змінили меню — змінився і сайт.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* Години + контакти (текст у HTML, працює без JS) */}
  <section class="section hours-contact" id="hours" aria-labelledby="hours-title">
    <div class="container hours-contact__grid">
      <div>
        <p class="hand">коли ми відчинені</p>
        <h2 id="hours-title">Години роботи</h2>
        <p class="muted hours-contact__note">
          {site.address.note}. {site.address.street}, {site.address.city}
        </p>
        <HoursTable {site} />
      </div>
      <div class="hours-contact__cta">
        <Tile src={illoUrl('croissant')} size={120} bg="soft" />
        <p class="hand">приходьте, ми заваримо</p>
        <Button href="/broniuvannia/" variant="primary">Забронювати столик</Button>
        <a class="arrow-link" href="/kontakty/">Контакти й карта <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="cta-band" aria-labelledby="cta-title">
    <div class="container cta-band__inner">
      <div>
        <p class="hand cta-band__kicker">без реєстрації</p>
        <h2 id="cta-title">Столик за пів хвилини</h2>
        <p>Дата, час і кількість гостей — підтвердимо дзвінком за 15 хвилин. Реєстрація не потрібна.</p>
      </div>
      <div class="cta-band__actions">
        <Button href="/broniuvannia/">Забронювати столик</Button>
        <Button href="/menu/kava/" variant="ghost">Подивитись меню</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    background: var(--c-cream);
    border-bottom: var(--border);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: var(--sp-9);
    align-items: center;
    padding-block: var(--sp-10) var(--sp-11);
  }
  .hero__kicker {
    margin-bottom: var(--sp-3);
  }
  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: -0.015em;
    margin-bottom: var(--sp-5);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--text-muted);
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-block: var(--sp-6) var(--sp-5);
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
  }
  .hero__art {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1;
    justify-self: center;
  }
  .hero__sun {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: var(--c-peach);
    border: 3px solid var(--c-ink);
  }
  .hero__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px dashed var(--c-ink);
    opacity: 0.5;
  }
  .hero__cup {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
  }
  .hero__stamp {
    position: absolute;
    right: 1%;
    bottom: 4%;
    width: 27%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--c-coral-deep);
    color: var(--c-white);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1rem, 0.6rem + 1.1vw, 1.6rem);
    line-height: 1.05;
    border-radius: 50%;
    border: 2.5px solid var(--c-ink);
    transform: rotate(-10deg);
  }

  /* смуга швидкої інформації */
  .visit-band {
    background: var(--c-teal);
    color: var(--c-white);
  }
  .visit-band__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-6);
    padding-block: var(--sp-4);
  }
  .visit-item {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 700;
    font-size: 1rem;
    min-height: 44px;
  }
  .visit-item svg {
    flex-shrink: 0;
  }
  .visit-band :global(.open-now) {
    background: transparent;
    color: var(--c-white);
    padding: 0;
  }
  .visit-band :global(.open-now[data-state='closed']) {
    box-shadow: none;
    color: var(--c-white);
  }
  .visit-item--link {
    color: inherit;
    text-decoration: none;
  }
  .visit-item--link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* спільний заголовок секції */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-7);
  }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--c-coral-deep);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .arrow-link:hover {
    border-bottom-color: var(--c-coral-deep);
  }
  .arrow-link:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .favorites {
    background: var(--c-paper);
  }
  .favorites__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-8);
  }

  .why {
    background: var(--c-cream);
  }
  .why__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-8);
    margin: var(--sp-7) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: why;
  }
  .why__item {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }
  .why__num {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--fs-num);
    line-height: 0.9;
    color: var(--c-coral-deep);
    flex-shrink: 0;
  }
  .why__item h3 {
    margin-bottom: var(--sp-2);
  }
  .why__item p {
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    max-width: 34ch;
  }

  .hours-contact {
    background: var(--c-paper);
    border-top: var(--border);
  }
  .hours-contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--sp-10);
    align-items: start;
  }
  .hours-contact__note {
    margin-block: var(--sp-2) var(--sp-5);
  }
  .hours-contact__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
    background: var(--c-cream);
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--sp-6);
  }

  .cta-band {
    background: var(--c-peach);
    border-top: var(--border);
  }
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    padding-block: var(--sp-9);
  }
  .cta-band__kicker {
    color: var(--c-ink);
  }
  .cta-band h2 {
    margin-block: var(--sp-1) var(--sp-3);
  }
  .cta-band p {
    max-width: 46ch;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  @media (max-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
    .hero__art {
      width: min(100%, 360px);
      order: -1;
    }
    .favorites__grid,
    .why__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hours-contact__grid {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
  }
  @media (max-width: 40rem) {
    .favorites__grid,
    .why__list {
      grid-template-columns: 1fr;
    }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__art {
      width: min(100%, 300px);
    }
    /* BR 001 на телефоні: менший відступ і менша ілюстрація, щоб адреса,
       години й телефон потрапили в перший екран 390×844 */
    .hero__grid {
      padding-block: var(--sp-5) var(--sp-7);
      gap: var(--sp-5);
    }
    .hero__art {
      order: 0;
      width: min(100%, 210px);
    }
    .hero__title {
      font-size: clamp(2rem, 1.6rem + 2.4vw, 2.5rem);
      line-height: 1.06;
      margin-bottom: var(--sp-3);
    }
    .hero__lead {
      font-size: 1rem;
      line-height: 1.45;
    }
    .hero__kicker {
      margin-bottom: 0;
      font-size: 1.5rem;
    }
    .hero__actions {
      margin-block: var(--sp-4) var(--sp-4);
    }
    .hero__copy {
      gap: var(--sp-3);
    }
  }
</style>
