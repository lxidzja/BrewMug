# Змінні середовища (приклад). Справжні значення — тільки у сховищі секретів платформи.
# Локально скопіюйте у .dev.vars (він у .gitignore).

# Telegram-сповіщення про нові заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Універсальний вебхук (Slack/ntfy/власний бот) — необов'язково
WEBHOOK_URL=

# Адреса сайту для sitemap/canonical
SITE_URL=https://brewmug.example

# Строк зберігання заявок (днів) — має збігатися з site.yaml → privacy.retentionDays
RETENTION_DAYS=90
